# CVAT (tailnet only): the labeling app for the detector corpus, running on furulid.
# Import this site from /etc/caddy/Caddyfile; the cvat behavior's `site` method installs it. The bind address is the Pi's tailnet IP.
cvat.vilberg.dev {
	bind 100.72.119.74
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	# furulid's tailnet IP; CVAT's own proxy routes on this site's name and trusts the tailnet's
	# X-Forwarded-Proto, so Django sees HTTPS and accepts the login form.
	reverse_proxy 100.90.231.74:8080
}
