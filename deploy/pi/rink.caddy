# Rink Replay web app (tailnet only): the static build from the web-build workflow.
# Import this site from /etc/caddy/Caddyfile. The address is this Pi's tailnet IP.
rink.vilberg.dev {
	bind 100.72.119.74
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	root * /var/www/rink
	encode zstd gzip
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# The footage service answers these itself; every other /footage path is a page of the web app.
	@service path /footage/api/* /footage/room/* /footage/worker/*
	@shell not path /assets/* /curriculum/* /plays/* /footage/api/* /footage/room/* /footage/worker/* *.png
	header @shell Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type application/manifest+json
	reverse_proxy @service 127.0.0.1:8794
	# The app routes by path (/lesson/<id>, /footage/<session>/<clip>), so a page that is not a file is the app.
	@page {
		not path /assets/* /curriculum/* /plays/* /footage/api/* /footage/room/* /footage/worker/*
		not file
	}
	rewrite @page /index.html
	file_server
}
