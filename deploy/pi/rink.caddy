# Rink Replay (tailnet only): the web app's static build, and the footage service behind /api.
# Import this site from /etc/caddy/Caddyfile. The address is this Pi's tailnet IP.
rink.vilberg.dev {
	bind 100.72.119.74
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8794
	}
	handle {
		root * /var/www/rink
		# Built assets have hashed names and never change; everything else is checked on each load.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type application/manifest+json
		# The app routes by path, so a page that is not a file is the app.
		try_files {path} /index.html
		file_server
	}
}
